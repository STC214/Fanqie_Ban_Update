# Local build products and caches
/usb_control_app/build/
/xposed_hook/build/
**/__pycache__/
*.py[cod]
*.idsig

# Keep signing material and machine configuration local
*.jks
*.keystore
.env
.env.*
local.properties

# Raw physical-device diagnostics remain local; aggregate reports stay in Git
/docs/usb-control-audit/**/phone-*.json
/docs/usb-control-audit/**/phone-*.xml
/docs/usb-control-audit/final-phone-identity.json
/docs/usb-control-audit/phone-ui/
/docs/usb-control-dark-mode/phone-install.json
/.local/

# Local upstream reference clone; package provenance is documented separately.
/TelemetryCleaner/

# IDE / Gradle machine state (do not hide release APKs, checksums or project docs).
/.idea/
/.vscode/
**/.gradle/
**/.cxx/
*.iml
*.hprof
Thumbs.db
.DS_Store
