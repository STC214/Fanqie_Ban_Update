+run(['adb', 'push', str(script), base + '/wallpaper.sh'])
+cmd = f'sh {base}/wallpaper.sh {base}/media {base}/state'
+old = 'LocalImport_' + 'abcdef0123456789abcdef0123456789'
+new = 'LocalImport_&_' + 'abcdef0123456789abcdef0123456789'
