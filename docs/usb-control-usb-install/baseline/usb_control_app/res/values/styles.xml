<resources>
    <style name="BaseTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2563EB</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F7FC</item>
        <item name="android:navigationBarColor">#F4F7FC</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F4F7FC</item>
    </style>
    <style name="LightTheme" parent="@style/BaseTheme"/>
    <style name="AppTheme" parent="@style/LightTheme"/>
    <style name="DarkTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#8AB4FF</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101722</item>
        <item name="android:navigationBarColor">#101722</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#101722</item>
        <item name="android:colorBackground">#101722</item>
    </style>
</resources>
