--- /dev/null
+++ b/usb_control_app/src/local/usbcontrol/Backdrop.java
@@ -0,0 +1,51 @@
+package local.usbcontrol;
+
+import android.content.Context;
+import android.graphics.*;
+import android.view.*;
+
+/** One uniform scale on both axes. Drag selects the visible region; pinch only zooms. */
+final class Backdrop extends View {
+    Bitmap bitmap;
+    float zoom=1, fx=.5f, fy=.5f;
+    int opacity=25;
+    boolean editable=false;
+    private final Paint paint=new Paint(Paint.ANTI_ALIAS_FLAG|Paint.FILTER_BITMAP_FLAG);
+    private final ScaleGestureDetector scale;
+    private float lastX,lastY;
+    Backdrop(Context c) {
+        super(c);
+        scale=new ScaleGestureDetector(c,new ScaleGestureDetector.SimpleOnScaleGestureListener(){
+            public boolean onScale(ScaleGestureDetector d){ zoom=Logic.clamp(zoom*d.getScaleFactor(),1,4);invalidate();return true; }
+        });
+        setContentDescription("背景预览；双指等比缩放，单指拖动选择显示区域");
+    }
+    void settings(Bitmap b,float z,float x,float y,int alpha){bitmap=b;zoom=z;fx=x;fy=y;opacity=alpha;invalidate();}
+    protected void onDraw(Canvas c){
+        super.onDraw(c); c.drawColor(Color.rgb(244,247,252));
+        if(bitmap==null||bitmap.isRecycled()||getWidth()==0||getHeight()==0)return;
+        float s=Logic.coverScale(bitmap.getWidth(),bitmap.getHeight(),getWidth(),getHeight(),zoom);
+        float w=bitmap.getWidth()*s,h=bitmap.getHeight()*s;
+        float x=(getWidth()-w)*Logic.clamp(fx,0,1),y=(getHeight()-h)*Logic.clamp(fy,0,1);
+        paint.setAlpha(Math.round(255*Logic.clamp(opacity/100f,0,1)));
+        c.drawBitmap(bitmap,null,new RectF(x,y,x+w,y+h),paint);
+    }
+    public boolean onTouchEvent(android.view.MotionEvent e){
+        if(!editable||bitmap==null)return false;
+        scale.onTouchEvent(e);
+        if(e.getActionMasked()==MotionEvent.ACTION_DOWN){lastX=e.getX();lastY=e.getY();getParent().requestDisallowInterceptTouchEvent(true);return true;}
+        if(e.getActionMasked()==MotionEvent.ACTION_MOVE){
+            if(!scale.isInProgress()&&e.getPointerCount()==1){
+                float s=Logic.coverScale(bitmap.getWidth(),bitmap.getHeight(),getWidth(),getHeight(),zoom);
+                float dx=bitmap.getWidth()*s-getWidth(),dy=bitmap.getHeight()*s-getHeight();
+                if(dx>0)fx=Logic.clamp(fx-(e.getX()-lastX)/dx,0,1);
+                if(dy>0)fy=Logic.clamp(fy-(e.getY()-lastY)/dy,0,1);
+                invalidate();
+            }
+            lastX=e.getX();lastY=e.getY();return true;
+        }
+        if(e.getActionMasked()==MotionEvent.ACTION_POINTER_UP){lastX=e.getX(e.getActionIndex()==0?1:0);lastY=e.getY(e.getActionIndex()==0?1:0);}
+        if(e.getActionMasked()==MotionEvent.ACTION_UP||e.getActionMasked()==MotionEvent.ACTION_CANCEL)getParent().requestDisallowInterceptTouchEvent(false);
+        return true;
+    }
+}
diff --git a/usb_control_app/src/local/usbcontrol/Logic.java b/usb_control_app/src/local/usbcontrol/Logic.java
new file mode 100644
--- /dev/null
+++ b/usb_control_app/src/local/usbcontrol/Logic.java
@@ -0,0 +1,44 @@
+package local.usbcontrol;
+
+import java.util.regex.*;
+
+/** Pure calculations and conservative ROM capability parsing; JVM-testable. */
+public final class Logic {
+    private Logic() {}
+    public static int lastNumber(String text, String label, int fallback) {
+        Matcher m = Pattern.compile(label + ":\\s*(\\d+)").matcher(text);
+        int value = fallback;
+        while (m.find()) value = Integer.parseInt(m.group(1));
+        return value;
+    }
+    public static int[] size(String text) {
+        Matcher m = Pattern.compile("(?:Physical|Override) size:\\s*(\\d+)x(\\d+)").matcher(text);
+        int[] v = {0, 0};
+        while(m.find()) { v[0] = Integer.parseInt(m.group(1)); v[1] = Integer.parseInt(m.group(2)); }
+        return v;
+    }
+    public static int densityForWidth(int widthPx, int smallestDp) {
+        if (widthPx < 1 || smallestDp < 280 || smallestDp > 720) throw new IllegalArgumentException("最小宽度范围为 280–720 dp");
+        int dpi = Math.round(widthPx * 160f / smallestDp);
+        if(dpi < 120 || dpi > 1000) throw new IllegalArgumentException("超出此屏幕的密度范围");
+        return dpi;
+    }
+    public static String installNamespace(String globals, String secure, String system) {
+        // Only this explicit USB-install key is supported; never invent absent settings
+        // or change ADB verifier / unknown-source / account-security settings.
+        String[] spaces = {"global", "secure", "system"};
+        String[] lists = {globals, secure, system};
+        String match = null;
+        for(int i=0;i<lists.length;i++) {
+            if(Pattern.compile("(?m)^adb_install_enabled=[01]\\r?$").matcher(lists[i]).find()) {
+                if(match != null) return null; // ambiguous vendor implementation
+                match = spaces[i];
+            }
+        }
+        return match;
+    }
+    public static float clamp(float v, float min, float max) { return Math.max(min, Math.min(max, v)); }
+    public static float coverScale(int bw,int bh,int vw,int vh,float zoom) {
+        return Math.max(vw/(float)bw, vh/(float)bh) * clamp(zoom, 1f, 4f);
+    }
+}
