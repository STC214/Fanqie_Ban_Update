# Normalize ordinary text; preserve bytes for sealed audit/rollback artifacts.
* text=auto
/.gitattributes text eol=lf
/README.md -text
/docs/** -text
/usb_control_app/** -text
/scripts/** -text
/analysis/** -text
/logs/** -text
# Release patches are byte-sensitive data (including CRLF context and space markers).
/releases/usb-control-*.patch -text -whitespace
/releases/usb-control-*.txt -text
/releases/usb-control-*.apk.sha256 -text
/docs/usb-control-wallpaper/*.patch -whitespace
/docs/usb-control-system-apps/*.patch -whitespace
/docs/usb-control-system-apps-delete-data/*.patch -whitespace
/docs/usb-control-system-apps-dialog/*.patch -whitespace
